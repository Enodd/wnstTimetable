<?xml version="1.0"?>
<ruleset name="wnstTimetable">
    <description>Project coding standard based on PSR-12.</description>

    <rule ref="PSR12"/>

    <file>app</file>
    <file>bootstrap/app.php</file>
    <file>bootstrap/providers.php</file>
    <file>config</file>
    <file>database</file>
    <file>helpers</file>
    <file>routes</file>
    <file>tests</file>

    <exclude-pattern>app/Models/generated/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
</ruleset>
